# Copy to .env and fill in your values: cp .env.example .env
# Load into your shell before running Terraform: set -a; source .env; set +a
# Never commit .env (it is listed in .gitignore).

# AWS credentials (IAM user or temporary credentials)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Only needed for temporary credentials (STS / SSO)
# AWS_SESSION_TOKEN=

# Terraform uses the `region` variable (default us-east-1), not this value.
# If you change the region, set TF_VAR_region below as well.
AWS_DEFAULT_REGION=us-east-1

# Optional: override Terraform variables (see variables.tf)
# TF_VAR_region=us-east-1
# TF_VAR_project_name=bank-balance-app
# TF_VAR_stage_name=dev
# TF_VAR_cors_allowed_origin=*
